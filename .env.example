# Samarth AI — example environment configuration.
# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated per process (all tokens/CSRF invalidated on restart).
SECRET_KEY=replace-with-long-random-secret
ENVIRONMENT=development
APP_URL=http://localhost:8000

# --- Auth / cookies ---
ACCESS_TOKEN_EXPIRE_MINUTES=4320
AUTH_COOKIE_NAME=access_token
# Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# SQLite (default): sqlite+aiosqlite:///./job_matcher.db
# PostgreSQL:       postgresql+asyncpg://user:password@localhost:5432/samarthai
DATABASE_URL=sqlite+aiosqlite:///./job_matcher.db

# --- AI providers (both optional; heuristic fallbacks run without keys) ---
AI_PRIMARY_PROVIDER=google
AI_FALLBACK_PROVIDER=openrouter
GOOGLE_API_KEY=
# Alternative name accepted for the Google key:
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_THINKING_BUDGET=8192
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# --- Localization ---
DEFAULT_LOCALE=en
